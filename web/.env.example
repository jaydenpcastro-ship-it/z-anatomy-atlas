# Fish Audio TTS proxy config (see web/api/tts.js). Get a key at https://fish.audio/app/developers
FISH_AUDIO_API_KEY=your-fish-audio-api-key
FISH_AUDIO_VOICE_ID=76bb6ae7b26c41fbbd484514fdb014c2
# s2.1-pro-free needs no API credit; switch to s2.1-pro (paid) for higher quality once credit is loaded.
FISH_AUDIO_MODEL=s2.1-pro-free

# Anatomy tutor chat + flag reviewer (api/chat.js, lib/review.js). Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: models and effort (defaults: tutor claude-haiku-5-5 at effort low, reviewer claude-opus-5-5 at effort high).
# TUTOR_MODEL=claude-haiku-5-5
# REVIEW_MODEL=claude-opus-5-5
# TUTOR_EFFORT=low
# REVIEW_EFFORT=high
# Site-wide cap on tutor messages per day (spend guard). Each visitor is also limited to 20 per 10 min, 150 per day.
TUTOR_DAILY_LIMIT=1000

# Flags, weekly tallies and rate limits live in Upstash Redis: Vercel dashboard -> Storage -> Upstash for Redis
# (free tier). Connecting it adds these two automatically.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your-upstash-token

# Password for the owner's review page (/admin). Use a long random string.
ADMIN_TOKEN=change-me-to-a-long-random-string
# Vercel sends this to the weekly tally cron (api/cron/weekly-tally.js). Any long random string.
CRON_SECRET=another-long-random-string
